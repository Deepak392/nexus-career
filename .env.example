# PostgreSQL container credentials
POSTGRES_PASSWORD=change_me_locally

# Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=local-only-change-this-to-a-random-secret-of-at-least-50-characters
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
STUDENT_EMAIL_DOMAIN=scds.saiuniversity.edu.in
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Password reset links
FRONTEND_BASE_URL=http://localhost:5173
PASSWORD_RESET_TIMEOUT=1800
# Local development: show reset emails (including the one-time link) in backend logs.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@nexus-career.local
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_TIMEOUT=10

# Production email example: configure your SMTP provider and use:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-smtp-username
# EMAIL_HOST_PASSWORD=your-smtp-password
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=Nexus Career <no-reply@your-domain.example>

# Host-side Django connection (PostgreSQL is published on port 5433)
PGDATABASE=nexus_career
PGUSER=nexus_user
PGPASSWORD=change_me_locally
PGHOST=127.0.0.1
PGPORT=5433
